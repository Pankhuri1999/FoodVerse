<style>
  .panel-root {
    flex-direction: column;
    width: 96px;
  }

  .fold-button {
    justify-content: flex-start;
    margin-top: 8px;
    margin-bottom: 8px;
    margin-left: 8px;
    margin-right: 8px;
  }

  .panel-content {
    flex-direction: column;
    gap: 6px;
    padding-top: 8px;
    padding-right: 16px;
    padding-bottom: 12px;
    padding-left: 16px;
  }

  .eyebrow {
    color: #6b5a00;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1.2px;
  }

  .eyebrow:dark {
    color: #e8c35a;
  }

  .heading {
    color: #1c1d20;
    font-size: 22px;
    font-weight: 700;
    line-height: 1.2;
  }

  .heading:dark {
    color: #f4f1ea;
  }

  .row {
    color: #3a3b40;
    font-size: 13px;
    line-height: 1.4;
  }

  .row:dark {
    color: #d2d6de;
  }

  .rule {
    height: 2px;
    width: 100%;
    background-color: #3aa8c4;
    margin-top: 4px;
    margin-bottom: 4px;
  }

  .button {
    justify-content: flex-start;
    margin-left: 16px;
    margin-right: 16px;
    margin-bottom: 8px;
  }
</style>
<Panel id="guide-root" class="panel-root">
  <Button id="guide-toggle" class="fold-button">
    <ButtonIcon>
      <CircleHelp></CircleHelp>
    </ButtonIcon>
    <ButtonLabel>Guide</ButtonLabel>
  </Button>
  <div id="guide-body" class="panel-content" style="display: none">
    <div class="eyebrow">MISSIONS</div>
    <div class="heading">Cosmic Kitchen</div>
    <div id="guide-hands" class="row">This is a seated kitchen. Press Enter VR. On a computer, hold Trigger on the Left or Right Touch pad to grab food. Stir with S.</div>
    <div class="rule"></div>
    <div class="eyebrow">INGREDIENTS</div>
    <div class="row">Cosmic Fruit · Star Pepper · Crystal Sugar · Chocolate · Mint Crystal · Space Leaves</div>
    <div class="eyebrow">RECIPES</div>
    <div id="guide-recipe" class="row">Ember Spark — Cosmic Fruit and Star Pepper. Requires heat.</div>
    <div id="guide-step-1" class="row">1. Pick up Cosmic Fruit and Star Pepper. Place both in the mixer bowl.</div>
    <div id="guide-step-2" class="row">2. Press Heat. If food floats, catch it or press the Stabilizer.</div>
    <div id="guide-step-3" class="row">3. Stir to 45% with an open hand, or press S on a computer.</div>
    <div id="guide-step-4" class="row">4. Place Ember Dragon on the Ice Gate, then set the cookie wafer on Cookie Bridge.</div>
    <div class="eyebrow">PLANET ARCHIVE</div>
    <div id="guide-archive" class="row">Ember Spark: locked · Grove Bloom: locked · Mint Current: locked</div>
    <Button id="guide-xr-button" class="button">
      <ButtonIcon>
        <RectangleGoggles></RectangleGoggles>
      </ButtonIcon>
      <ButtonLabel>Enter VR</ButtonLabel>
    </Button>
  </div>
</Panel>
